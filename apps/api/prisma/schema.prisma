datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String
  fullName      String
  role          String             @default("CITIZEN") // "CITIZEN" | "ADMIN"
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  complaints    Complaint[]
  supports      ComplaintSupport[]
  statusUpdates StatusEvent[]

  @@map("users")
}

model Department {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String      @unique
  slaHours    Int         @default(48)
  description String?
  complaints  Complaint[]

  @@map("departments")
}

model Complaint {
  id                 String             @id @default(cuid())
  trackingCode       String             @unique
  title              String
  description        String
  originalText       String?
  language           String             @default("en")
  category           String
  status             String             @default("REPORTED")
  priority           String             @default("MEDIUM")
  impactScore        Int                @default(0)
  scoreBreakdown     String             // JSON stringified ScoreBreakdown
  aiReasoning        String?
  aiSource           String             @default("RULE_BASED") // "GEMINI" | "RULE_BASED"
  lat                Float
  lng                Float
  address            String?
  imageUrl           String?
  afterImageUrl      String?
  verificationResult String?            // JSON stringified AIVerificationOutput
  supportCount       Int                @default(0)
  slaDueAt           DateTime
  isEscalated        Boolean            @default(false)
  citizenId          String?
  citizen            User?              @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id])
  statusEvents       StatusEvent[]
  supports           ComplaintSupport[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([lat, lng])
  @@index([isEscalated])
  @@map("complaints")
}

model StatusEvent {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      String
  remarks     String?
  updatedById String?
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([complaintId])
  @@map("status_events")
}

model ComplaintSupport {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([complaintId, userId])
  @@map("complaint_supports")
}
